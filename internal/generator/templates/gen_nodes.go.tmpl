}

{{end}}{{end}}// Accept calls the appropriate visit method on the visitor.
func (n *{{.Name}}) Accept(visitor Visitor) {
	visitor.Visit{{.Name}}(n)
}

// ChildNodes returns all child nodes of the current node.
func (n *{{.Name}}) ChildNodes() []Node {
	nodes := []Node{}
{{- range .Fields}}
{{- if eq .Type "node"}}
	nodes = append(nodes, n.{{.GoProp}})
{{- else if eq .Type "node?"}}
	if n.{{.GoProp}} != nil {
		nodes = append(nodes, n.{{.GoProp}})
	}
{{- else if eq .Type "node[]"}}
	nodes = append(nodes, n.{{.GoProp}}...)
{{- end}}
{{- end}}
	return nodes
}

// CompactChildNodes returns all non-nil child nodes.
func (n *{{.Name}}) CompactChildNodes() []Node {
	nodes := []Node{}
{{- range .Fields}}
{{- if eq .Type "node"}}
	nodes = append(nodes, n.{{.GoProp}})
{{- else if eq .Type "node?"}}
	if n.{{.GoProp}} != nil {
