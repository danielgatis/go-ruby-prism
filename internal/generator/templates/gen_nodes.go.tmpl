{{- end}}
}

// New{{.Name}} creates a new {{.Name}}.
func New{{.Name}}(nodeID int, location Location, flags uint32{{range .Fields}}, {{.GoName}} {{.GoType}}{{end}}) *{{.Name}} {
	return &{{.Name}}{
		NodeID:   nodeID,
		Location: location,
		flags:    flags,
{{- range .Fields}}
		{{.GoProp}}: {{.GoName}},
{{- end}}
