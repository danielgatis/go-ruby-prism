}

{{if .FlagSet}}{{$node := .}}{{range .FlagSet.Values}}// Is{{camelcase .Name}} returns true if this node has the {{camelcase .Name}} flag.
func (n *{{$node.Name}}) Is{{camelcase .Name}}() bool {
